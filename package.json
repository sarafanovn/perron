{
  "name": "perron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -b && vite build --mode extension && node extension/write-manifest.mjs && node extension/generate-icons.mjs",
    "package:extension": "web-ext build --source-dir dist-extension --artifacts-dir web-ext-artifacts --overwrite-dest",
    "sign:extension": "web-ext sign --source-dir dist-extension --artifacts-dir web-ext-artifacts --channel unlisted",
    "package:source": "mkdir -p web-ext-artifacts && git archive --format=zip --output web-ext-artifacts/perron-source.zip HEAD",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.134.0",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "web-ext": "^10.8.0"
  }
}
